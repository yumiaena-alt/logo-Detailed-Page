# Replicate API token — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [1단계] 사용할 Inpainting 모델 (기본: Stable Diffusion Inpainting)
# Flux Fill 사용 시: REPLICATE_MODEL=black-forest-labs/flux-fill-dev
# REPLICATE_MODEL=

# [3단계] 사용할 Studio Rendering 모델 (기본: SDXL img2img)
# Flux Dev 사용 시: REPLICATE_RENDER_MODEL=flux
# REPLICATE_RENDER_MODEL=
